{
  "node": "<a href=\"#{{TARGET}}\" class=\"time-map__node\" data-time-node=\"{{ID}}\" data-time-item=\"{{TARGET}}\" data-era=\"{{ERA}}\" data-lane=\"{{LANE}}\" data-lane-span=\"{{SPAN}}\" style=\"--era:{{ERA_CSS}};--lane:{{LANE_CSS}};--lane-span:{{SPAN}}\" aria-label=\"{{LABEL}}\"><span class=\"time-map__photo\">{{PHOTO}}</span><span class=\"time-map__caption\">{{CAPTION}}</span></a>",
  "detail": "<details id=\"{{TARGET}}-fallback\" data-time-detail=\"{{TARGET}}\" class=\"time-map__detail\"><summary>{{TITLE}}</summary><article id=\"{{TARGET}}\" class=\"item time-map__scene spoiler-revealed\">{{VISUAL}}<div class=\"copy\"><h3 class=\"scene-title\">{{TITLE}}</h3><p class=\"scene-desc\">{{BODY}}</p>{{LINK}}</div></article></details>",
  "frame": "<section id=\"{{PREFIX}}-map\" class=\"time-map\" aria-label=\"{{TITLE}}\"><div class=\"time-map__content reader-guide__content\"><header><h2>{{TITLE}}</h2><p>{{SUMMARY}}</p></header>{{SPACE}}<div class=\"time-map__legend\" aria-label=\"시간 지도 연결선\">{{LEGEND}}</div><div class=\"time-map__canvas\" style=\"--era-count:{{ERAS}};--lane-count:{{LANES}}\"><svg class=\"time-map__connections\" aria-hidden=\"true\"></svg>{{AXES}}{{NODES}}</div><script type=\"application/json\" class=\"time-map__data\">{{MODEL}}</script><p class=\"time-map__hint\">사진을 누르면 장면이 펼쳐집니다.</p><div class=\"time-map__details\">{{DETAILS}}</div><details class=\"time-map__reading\"><summary>연결을 글로 읽기</summary><ul>{{EDGES}}</ul></details></div><button class=\"spoiler-cover\" type=\"button\" aria-label=\"시간 지도 내용 보기\" hidden><span><small>시간 지도</small><strong>내용 보기</strong></span></button></section>"
}
